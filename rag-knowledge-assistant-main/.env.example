RAG_SERVICE_NAME=trustaware-rag-assistant
# RAG_ENV=development  # production mode requires RAG_API_KEY; leave unset for the public portfolio demo
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_RELOAD=false
RAG_STORAGE_PATH=./data/rag-index.json
RAG_UPLOAD_DIR=./data/uploads
# Authentication is disabled when RAG_API_KEY is empty (local/public-demo use only). For a private deployment set:
# RAG_API_KEY=your-long-random-secret
RAG_RATE_LIMIT_REQUESTS=12
RAG_RATE_LIMIT_WINDOW_SECONDS=60
RAG_MAX_REQUEST_BYTES=5242880
RAG_VECTOR_STORE=json
# RAG_QDRANT_URL=http://localhost:6333
# RAG_QDRANT_API_KEY=
# RAG_QDRANT_COLLECTION=rag-chunks
# RAG_DB_URL=  # e.g. postgresql+psycopg://... (metadata store; default: SQLite beside the index)
RAG_RERANKER=term_overlap
# RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RAG_DEFAULT_CHUNK_SIZE=800
RAG_DEFAULT_CHUNK_OVERLAP=120
RAG_DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_LLM_PROVIDER=openrouter
RAG_LLM_MODEL=openrouter/free
OPENROUTER_API_KEY=
RAG_LLM_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Gemini alternative: RAG_LLM_PROVIDER=gemini, RAG_LLM_MODEL=gemini-3.7-flash, GEMINI_API_KEY=...
# Generic OpenAI-compatible alternative: RAG_LLM_PROVIDER=openai_compatible, RAG_LLM_API_KEY=..., RAG_LLM_MODEL=..., RAG_LLM_BASE_URL=...
RAG_LLM_TIMEOUT_SECONDS=30
RAG_LLM_CONNECT_TIMEOUT_SECONDS=8
RAG_LLM_READ_TIMEOUT_SECONDS=24
RAG_LLM_MAX_RETRIES=2
# Disable by default for faster first-token responses; enable to spend an extra model call expanding queries.
RAG_LLM_QUERY_REWRITE_ENABLED=false
# Optional OpenRouter fallback model IDs, comma-separated:
# RAG_LLM_FALLBACK_MODELS=provider/model-a:free,provider/model-b:free
# RAG_LLM_MAX_OUTPUT_TOKENS=1024  # cap the generated answer length (tokens; 0/empty = unlimited)
RAG_DOCS_ENABLED=true
RAG_LOG_LEVEL=INFO
RAG_ALLOWED_ORIGINS=http://localhost:8000
RAG_TRUST_PROXY_HEADERS=false
# Optional protected browser sign-in (configure both values):
# RAG_UI_PASSWORD=replace-with-a-long-workspace-passphrase
# RAG_JWT_SECRET=replace-with-a-long-random-secret
# RAG_JWT_TTL_SECONDS=3600
