RAG_SERVICE_NAME=trustaware-rag-assistant
RAG_HOST=0.0.0.0
RAG_PORT=8000
RAG_RELOAD=false
RAG_STORAGE_PATH=./data/rag-index.json
RAG_UPLOAD_DIR=./data/uploads
RAG_API_KEY=
RAG_RATE_LIMIT_REQUESTS=120
RAG_RATE_LIMIT_WINDOW_SECONDS=60
RAG_MAX_REQUEST_BYTES=10485760
RAG_REQUEST_TIMEOUT_SECONDS=30
RAG_DEFAULT_CHUNK_SIZE=800
RAG_DEFAULT_CHUNK_OVERLAP=120
RAG_DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
